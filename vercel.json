{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/bookings",
      "schedule": "30 21 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "production": true
    }
  }
}
