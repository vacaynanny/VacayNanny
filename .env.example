# Reference only: copy the values needed for your intended environment.
# Keep actual credentials in ignored .env.local or Vercel environment settings.
# Start with npm run setup:local and npm run dev:review for isolated UI review.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# No messages are sent while disabled. Enable only after verifying the sender.
EMAIL_DELIVERY_MODE=disabled
RESEND_API_KEY=
RESEND_FROM_EMAIL=VacayNanny <noreply@vacaynanny.net>
RESEND_REPLY_TO_EMAIL=hello@vacaynanny.net

# setup:local generates this locally. Configure a separate value on Vercel.
CRON_SECRET=

# Server only. sk_test_... for local/staging; sk_live_... for production.
# The Kenyan merchant account must enable card and mobile_money channels.
PAYSTACK_SECRET_KEY=
# Recommended timestamped signing secret (whsec_...). Empty uses legacy signatures.
PAYSTACK_WEBHOOK_SECRET=

# Final blank PDF's private nanny-documents path, without the bucket prefix.
# Example: agreements/vacaynanny-nanny-agreement.pdf
NANNY_AGREEMENT_STORAGE_PATH=

# Stable server-only key for encrypted notification bodies and private enquiry links.
# Set before production and preserve it while queued jobs/private enquiry links exist.
NOTIFICATION_ENCRYPTION_KEY=
